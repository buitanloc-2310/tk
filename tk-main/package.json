{
  "name": "sfn-member-portal",
  "version": "6.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply tk --remote",
    "db:migrate:local": "wrangler d1 migrations apply tk --local",
    "check": "node scripts/fast-check.mjs",
    "build": "node scripts/verify-release.mjs",
    "test": "node scripts/verify-release.mjs && node scripts/validate-center.mjs",
    "verify": "node scripts/verify-release.mjs",
    "validate": "node scripts/validate-center.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.30.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module"
}
